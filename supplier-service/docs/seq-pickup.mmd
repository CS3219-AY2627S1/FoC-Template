%% Order accepts the listing as a pickup only when status is approved.
sequenceDiagram
    actor Student
    participant Supplier as Supplier Service
    actor Reviewer as Admin
    participant Order as Order Service

    Student->>Supplier: submit a listing
    Note over Supplier: saved as pending
    Supplier-->>Student: 201

    alt admin approves
        Reviewer->>Supplier: set status to approved
        Note over Supplier,Reviewer: visible in the catalogue
    else admin rejects
        Reviewer->>Supplier: set status to rejected, with a reason
        Note over Supplier,Reviewer: stays off the catalogue
    end

    Order->>Supplier: read the listing by id
    alt status is approved
        Supplier-->>Order: used as the pickup
    else pending or rejected
        Note over Supplier,Order: Order refuses it
    end
