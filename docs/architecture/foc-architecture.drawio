        <mxCell id="d4-job" parent="1" style="sketch=0;dashed=0;aspect=fixed;fillColor=#326CE5;strokeColor=#FFFFFF;shape=mxgraph.kubernetes.icon;prIcon=job;fontSize=12;fontStyle=1;fontColor=light-dark(#1F2937,#E5E7EB);html=1;labelBackgroundColor=default;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" value="migrate Job" vertex="1">
