        </mxCell>
        <mxCell id="infra-argo" parent="1" style="shape=image;aspect=fixed;imageAspect=0;fontSize=12;fontStyle=1;fontColor=light-dark(#1F2937,#E5E7EB);html=1;labelBackgroundColor=default;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;image=data:image/svg+xml,;" value="Argo CD&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;in EKS&lt;/span&gt;" vertex="1">
          <mxGeometry height="44" width="44" x="560" y="332" as="geometry" />
        </mxCell>
        <mxCell id="infra-panel" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=13;fillColor=light-dark(#F9FAFB,#111827);strokeColor=light-dark(#D1D5DB,#374151);fontColor=light-dark(#1F2937,#E5E7EB);" value="&lt;div style=&quot;font-size:18px;margin-bottom:8px;&quot;&gt;&lt;b&gt;Steps&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;span style=&quot;color:light-dark(#7C3AED,#A78BFA);font-size:20px;font-weight:bold;&quot;&gt;①&lt;/span&gt; &lt;b&gt;Apply:&lt;/b&gt; The developer signs in with AWS SSO and runs &lt;code&gt;terraform apply&lt;/code&gt; from a laptop. Infra changes are not run by CI.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;span style=&quot;color:light-dark(#7C3AED,#A78BFA);font-size:20px;font-weight:bold;&quot;&gt;②&lt;/span&gt; &lt;b&gt;State:&lt;/b&gt; Terraform stores and locks its state in an S3 bucket.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;span style=&quot;color:light-dark(#7C3AED,#A78BFA);font-size:20px;font-weight:bold;&quot;&gt;③&lt;/span&gt; &lt;b&gt;Provision:&lt;/b&gt; Terraform creates the dev environment: network, EKS, RDS, ECR, CloudFront + S3, and supporting services (Secrets Manager, SES, IAM).&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;span style=&quot;color:light-dark(#7C3AED,#A78BFA);font-size:20px;font-weight:bold;&quot;&gt;④&lt;/span&gt; &lt;b&gt;Bootstrap:&lt;/b&gt; Terraform installs Argo CD into EKS, pointed at the repo.&lt;/div&gt;&lt;div style=&quot;margin-bottom:8px;&quot;&gt;&lt;span style=&quot;color:light-dark(#7C3AED,#A78BFA);font-size:20px;font-weight:bold;&quot;&gt;⑤&lt;/span&gt; &lt;b&gt;Hand-off:&lt;/b&gt; From then on Argo CD deploys everything inside the cluster from git (page 6).&lt;/div&gt;" vertex="1">
          <mxGeometry height="450" width="400" x="750" y="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
