meta {
  name: Catalogue success
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/orders/delivery-points?page=0&size=20
  body: none
  auth: none
}
headers {
  X-User-Id: 9a290e37-334d-3b8e-946d-2342f27b2f6e
  X-Permitted-Action: true
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content.length).to.be.above(0);
    expect(res.getBody().content[0].code).to.exist;
  });
}
