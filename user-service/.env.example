# Tool: ChatGPT (Codex, model: gpt-6.1-sol), date: 2026-11-03
# Scope: Added optional SES email configuration placeholders for cloud delivery.
# Author review: I validated correctness and added boundary checks where needed.

# AI Assistance Disclosure:
# Tool: ChatGPT (Codex, model: gpt-5.6-terra), date: 2026-09-19, 2026-09-20, 2026-09-21
# Tool: GitHub Copilot, date: 2026-09-20
# Tool: ChatGPT (Codex, model: gpt-6.1-sol), date: 2026-10-08, 2026-10-10
# Scope: Drafted local database, OTP, signing-key, and broker settings and service credential
# placeholders.
# Author review: I validated correctness and added boundary checks where needed.

# Copy to .env, or run scripts/generate_dev_secrets.py after starting local Supabase.
# Do not commit .env or files under secrets/.

ENVIRONMENT=development
LOG_LEVEL=INFO
# Local Supabase PostgreSQL uses port 15422; the generator reads its URL from the CLI.
DATABASE_URL=
# Docker containers cannot reach the Supabase CLI database through 127.0.0.1.
# The development-secret script derives this local-only value from DATABASE_URL.
DATABASE_URL_DOCKER=

# RSA key paths, relative to user-service/. Generated by the development-secret script.
JWT_PRIVATE_KEY_PATH=secrets/development/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=secrets/development/jwt_public_key.pem
JWT_ISSUER=foc-user-service
JWT_AUDIENCE=foc-services
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=86400
JWT_SESSION_IDLE_TIMEOUT_SECONDS=1800

# Generated by scripts/generate_dev_secrets.py.
OTP_HMAC_SECRET=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=60
BCRYPT_ROUNDS=12
# Shared only with Supplier Service for its current authorization-decision call.
# Never send this to a browser, log it, or reuse it for another service identity.
SUPPLIER_SERVICE_SHARED_SECRET=
# Independently generated and shared only with Chat Service; no legacy fallback.
# Optional at startup; both internal chat interfaces fail closed while blank.
CHAT_SERVICE_SHARED_SECRET=

# Required only by the one-shot local bootstrap-super-admin command. Set these
# explicit values in ignored .env or a deployment secret store; never commit them.
BOOTSTRAP_SUPER_ADMIN_USERNAME=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Optional; defaults to BOOTSTRAP_SUPER_ADMIN_USERNAME when omitted.
BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=

# Local supporting services. The secret generator supplies non-guest RabbitMQ
# credentials; Compose uses the same values for the service container.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@foc.local
# SMTP/Mailpit remains the development default. SES uses the AWS SDK's normal
# credential chain (an EC2 instance role in AWS); never add access keys here.
OTP_EMAIL_PROVIDER=smtp
SES_REGION=
SES_FROM_ADDRESS=
RABBITMQ_USER=foc_user_service
RABBITMQ_PASSWORD=replace-with-local-only-password
RABBITMQ_URL=amqp://foc_user_service:replace-with-local-only-password@127.0.0.1:5672/
# The outbox publisher sends durable user.registered.v1 messages here. It logs
# only safe event metadata and retries transient failures with bounded backoff.
OUTBOX_EXCHANGE_NAME=foc.events
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LEASE_SECONDS=30
OUTBOX_RETRY_INITIAL_DELAY_SECONDS=1
OUTBOX_RETRY_MAX_DELAY_SECONDS=60
