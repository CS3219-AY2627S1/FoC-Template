# AI Assistance Disclosure:
# Tool: Claude Code (Claude Opus), date: 2026-09-25
# Scope: AI generated the original example environment file.
# Author review: Author decided to commit it for teammates, reviewed and
# approved. See user-service/ai/usage-log.md, entry 001.

# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- Database ---
# Local Docker Postgres (compose only; local-only values)
POSTGRES_USER=user_service
POSTGRES_PASSWORD=user_service
POSTGRES_DB=user_service
# For `npm run dev` on your Mac; reaches the user-db container via its published port.
DATABASE_URL="postgresql://user_service:user_service@localhost:5432/user_service?schema=public"

# --- Servers ---
# REST (Express).
PORT=3001
# gRPC (internal profile lookup).
GRPC_PORT=50051
# Order Service gRPC address used by account deletion eligibility checks.
ORDER_GRPC_ADDR=localhost:50053

# --- JWT ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=15m

# --- Refresh Token ---
NODE_ENV=development
REFRESH_TOKEN_TTL_DAYS=7

# --- Outbox / RabbitMQ ---
# Dispatcher publishes user.created after sign-up commits. Sign-up itself never
# talks to the broker; a missing broker must not fail POST /users/register.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# --- Redis (OTP cache) ---
REDIS_URL=redis://localhost:6379
# 32-byte key (base64). Generate with: npm run keys:otp
OTP_HMAC_KEY_PATH=./keys/otp.key
# Path is relative to the directory you start the service from.
REDIS_OTP_LUA=./src/scripts/atomic.lua

# Mailpit. Inside Docker Compose this is the service name, not localhost.
SMTP_HOST=localhost
SMTP_PORT=1025
