# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ... Add more variables as needed

# ---- order-service ------------------------------------------
ORDER_SERVICE_PORT=3002
ORDER_DB_PORT=5433
ORDER_DB_USER=order
ORDER_DB_PASSWORD=order
ORDER_DB_NAME=order_db
ORDER_REDIS_PORT=6379
# order-worker reaches credit-service at http://credit-service:3003 inside compose
# (CREDIT_SERVICE_URL, set in compose.yaml; no host variable needed).

# ---- credit-service -----------------------------------------
# AI Assistance Disclosure:
# Tool: Claude Code (model: claude-opus-5), date: 2026-09-26
#   2026-09-26: Recess iteration - added the credit-service variables read by
#     compose.yaml. No requirements, architecture, schema, or API decisions were
#     made by the AI tool.
#     Author review: Reviewed and verified by Koh Wee Jean, 2026-11-10.
# Tool: Claude Code (model: claude-opus-5), date: 2026-10-22
#   2026-10-22: Credit transfer consumer - noted credit-worker's broker.
#     No requirements, architecture, schema, or API decisions were made by the AI tool.
#     Author review: Reviewed and verified by Koh Wee Jean, 2026-11-10.
CREDIT_SERVICE_PORT=3003
CREDIT_DB_PORT=5435
# Owner of the credit-service tables. Used to bootstrap the database and run migrations.
CREDIT_DB_USER=credit
CREDIT_DB_PASSWORD=credit
CREDIT_DB_NAME=credit_db
# Least-privilege role the service connects as (NFR8.2.3): no DELETE anywhere and no
# UPDATE on transaction_log, so a logged credit operation cannot be altered or removed.
# The name must stay credit_app — credit-service/src/db/grants.sql grants to that role.
CREDIT_APP_USER=credit_app
CREDIT_APP_PASSWORD=credit_app
# credit-worker consumes order-service's credit_transfer jobs from order-redis:6379
# inside compose (REDIS_HOST / REDIS_PORT, set in compose.yaml; no host variable
# needed, the same way order-worker reaches credit-service).

# ---- supplier-service -----------------------------------------
# AI Assistance Disclosure:
# Tool: Claude Code (model: claude-sonnet-5), date: 2026-09-29
#   2026-09-29: Added the supplier-service variables read by compose.yaml, matching
#     supplier-service/.env.example's existing defaults (root user, fixed db name). No
#     requirements, architecture, schema, or API decisions were made by the AI tool.
#     Author review: Congchen
SUPPLIER_SERVICE_PORT=3004
SUPPLIER_DB_PORT=5436
SUPPLIER_DB_PASSWORD=supplier_root_password
# Alternative to a user JWT on GET /suppliers/:id and GET /suppliers/reference/location, for
# order-service's scheduled-errands worker. Same value as order-service's own secret.
SUPPLIER_ORDER_SERVICE_API_KEY=replace-with-supplier-order-service-secret
# Sent by supplier-worker to order-service's POST /suppliers/:id/cancel-orders on a supplier
# shut-down. Same value in order-service and supplier-worker.
ORDER_SUPPLIER_SERVICE_API_KEY=replace-with-order-supplier-service-secret

# AI-generated 
# ---- chat-service ----------------------------------------------------------
CHAT_SERVICE_PORT=3005
CHAT_DB_PASSWORD=chat_db_password
CHAT_SERVICE_API_KEY=replace-with-chat-service-secret
TRANSLATION_LLM_KEY=replace-with-google-ai-studio-key
TRANSLATION_LLM_MODEL=gemini-3.1-flash-lite

# Run node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# to generate a secret

# Host-side order worker chat URL (Compose supplies the internal URL).
CHAT_SERVICE_URL=http://localhost:3005

# AI-generated
# Same value as user-service/.env and order-service/.env for the scheduled worker.
USER_ORDER_SERVICE_API_KEY=replace-with-user-order-service-secret
