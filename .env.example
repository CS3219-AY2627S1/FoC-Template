# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────
# ---- Global -------------------------------------------------
LOG_LEVEL=INFO
# Vector reads Docker logs through this host socket. Linux uses the default;
# Docker Desktop users may need to set this to their Docker context socket.
VECTOR_DOCKER_SOCKET=/var/run/docker.sock
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Required by the Grafana container; use a unique secret outside local development.
GRAFANA_ADMIN_PASSWORD='change-me-locally'

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- User Database ------------------------------------------
POSTGRES_USER=foc
# Single-quote passwords so Compose preserves `$`, spaces, and `#` literally.
POSTGRES_PASSWORD='change-me-locally'
# Shared only by trusted service containers when calling User Service internal APIs.
USER_SERVICE_INTERNAL_TOKEN='replace-with-a-long-random-token'
# Optional one-shot first administrator bootstrap. Set all four values to
# enable it; leaving all four empty makes the bootstrap job a no-op.
BOOTSTRAP_ADMIN_NUS_STUDENT_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Supplier Service (local scaffold examples) ---------------
# Dummy values: replace with deployed addresses/credentials when integrating.
# Export these for local runs; the application does not auto-load .env.
DATABASE_URL=postgresql+psycopg://test_user:test_password@localhost:5432/test_supplier
# Local only; production defaults to requiring HTTPS for USER_SERVICE_URL.
APP_ENV=development
USER_SERVICE_URL=https://localhost:8000
# Local internal CA and User Service server certificate paths. Generate the
# development files with scripts/generate-dev-tls.ps1; production should use
# certificates issued and rotated by the deployment platform.
INTERNAL_CA_CERT_FILE=./certs/ca.crt
USER_SERVICE_TLS_CERT_FILE=./certs/user-service.crt
USER_SERVICE_TLS_KEY_FILE=./certs/user-service.key
USER_SERVICE_CA_FILE=./certs/ca.crt
AUTH_TIMEOUT_SECONDS=3

SUPPLIER_POSTGRES_DB=supplier_db
SUPPLIER_POSTGRES_USER=supplier_admin
SUPPLIER_POSTGRES_PASSWORD=replace_with_a_local_password

# ... Add more variables as needed

# Separate supplier migration and runtime roles; Compose provisions roles and grants.
SUPPLIER_MIGRATION_PASSWORD=replace_with_a_migration_password
SUPPLIER_RUNTIME_PASSWORD=replace_with_a_runtime_password

# ---- Credit Service -----------------------------------------
# Credit values are integer-only. This initial allocation is granted at most
# once by the student-owned account provisioning business logic.
CREDIT_DB_USER=foc_credits
CREDIT_DB_PASSWORD='change-me-locally'
INITIAL_CREDIT_ALLOCATION=100
# Initial delivery plus one retry after each configured delay. The default
# therefore gives five attempts, a longest wait of 4s, and 7.5s total waiting.
CREDIT_RETRY_BACKOFF_SECONDS=0.5,1,2,4

# The Compose Kafka broker is internal at kafka:9092 and needs no local secret.

# ---- Order Service ------------------------------------------
# Required before `docker compose up`. The password stays out of the database URL;
# Compose passes it as PGPASSWORD. Kafka is reached at kafka:9092 with no credentials.
ORDER_DB_USER=foc_orders
ORDER_DB_PASSWORD='change-me-locally'

# ---- Notification Service -----------------------------------
# Required before `docker compose up`. The password stays out of the database URL;
# Compose passes it as PGPASSWORD.
NOTIFICATION_DB_USER=foc_notifications
NOTIFICATION_DB_PASSWORD='change-me-locally'
# ISO-8601 with a timezone. Events before this time create no notifications.
NOTIFICATIONS_START_AT=2026-11-04T00:00:00+08:00
# Initial delivery plus one retry after each delay. Empty means a single attempt.
NOTIFICATION_RETRY_BACKOFF_SECONDS=0.5,1,2,4
# Live stream (GET /notifications/stream): seconds between ": ping" heartbeats,
# and seconds before the server closes a stream so the client reconnects.
SSE_HEARTBEAT_SECONDS=20
SSE_MAX_LIFETIME_SECONDS=600

# Supplier images: public browser URL, compiled into the frontend at build time.
SUPPLIER_IMAGE_PORT=8090
NEXT_PUBLIC_SUPPLIER_IMAGE_BASE_URL=http://localhost:8090
